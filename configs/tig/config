## やけに丁寧なtigの設定ガイド（表示制御編） - Qiita
## http://qiita.com/yoshikazusawa/items/d99e8b5d6f6a45aa6e2e
# main viewの左端にコミットIDを表示する
# set main-view = commit-title:graph=yes,refs=yes date id author 
# デフォルト
# set main-view = date author commit-title:graph=yes,refs=yes
#
set main-view = line-number:no author:full date:custom,format="%Y-%m-%d %H:%M" id:yes commit-title:yes,graph:v2,refs,overflow=no

# 画面を垂直方向に分割する
# set vertical-split = yes
# 横分割に強制する
set vertical-split = no
# デフォルト値
# set vertical-split = auto

# 水平分割したウィンドウの下画面サイズを % で指定（行数指定も可）
set split-view-height = 60%

# 差分の前後の表示行数（diff-context)を指定
set diff-context = 6

# 文字単位のハイライトを有効にする
set diff-highlight = true

## Git - やけに丁寧なtigのキーバインド設定ガイド - Qiita
## http://qiita.com/yoshikazusawa/items/3eaa6db78fa348d38bfe
# g/G で先頭・末尾へ移動する
bind generic g move-first-line
bind generic G move-last-line

# ページ移動
bind generic <Ctrl-f> scroll-page-down
bind generic <Ctrl-b> scroll-page-up

# https://qiita.com/numanomanu/items/513d62fb4a7921880085
bind main B !git rebase -i %(commit)
bind diff B !git rebase -i %(commit)

bind status C !git commit -v
bind status + !git commit -v --amend

# トラッキングされていないファイルを削除
bind status D ?git clean -d -f -- %(file)

# S で stash push
bind generic S ?git stash push -m "%(prompt Enter stash comment: )"

# Y で stash pop
bind stash Y ?git stash pop %(stash)

# push.autoSetupRemote を利用する
bind generic P ?git push

bind main T !git tag %(prompt) %(commit)

bind main O !git checkout %(commit)

# 選択したコミットを含むブランチにチェックアウトする
bind main X !sh -c '"${XDG_CONFIG_HOME:-$HOME/.config}/tig/checkout-commit-branch" "$1"' - %(commit)

# github
bind branch [ !gh browse --branch %(branch)
bind main { !gh pr create --web

# open commit at github
bind main o !gh browse %(commit)
bind diff o !gh browse %(commit)
bind log  o !gh browse %(commit)

# Amend
bind main A !git commit --amend

# 選択したコミットのメッセージを変更する (子孫のコミットも書き換わる)
bind main M !sh -c '"${XDG_CONFIG_HOME:-$HOME/.config}/tig/reword-commit" "$1"' - %(commit)

# View diffs using delta
bind main V >sh -c "git show %(commit) | hunk pager"
bind status V >sh -c "git diff -- %(file) | hunk pager"

# カラー設定
# diff-view で境界が見やすくなるように変更
color diff-header default magenta
color diff-chunk black white

color main-head cyan default bold
color cursor yellow default reverse
